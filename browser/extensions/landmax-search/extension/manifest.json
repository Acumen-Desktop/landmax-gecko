{
  "manifest_version": 2,
  "name": "Landmax Search",
  "version": "0.3.0",
  "description": "Landmax Search: Google, DuckDuckGo and Brave without ads, with history and a word on whom to trust. Wakes only in the Search app.",
  "browser_specific_settings": { "gecko": { "id": "search@landmax.global" } },
  "background": { "scripts": ["background.js"] },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "tabHide",
    "contextualIdentities",
    "cookies",
    "storage",
    "nativeMessaging"
  ],
  "web_accessible_resources": ["search.html"]
}
