{
  "manifest_version": 2,
  "name": "Landmax Search",
  "version": "0.1.0",
  "description": "Search done right: Google's answer and results as plain cards, no ads, one search per click.",
  "browser_specific_settings": { "gecko": { "id": "search@landmax.global" } },
  "background": { "scripts": ["background.js"] },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "tabHide",
    "contextualIdentities",
    "cookies",
    "storage",
    "nativeMessaging"
  ],
  "web_accessible_resources": ["search.html"]
}
