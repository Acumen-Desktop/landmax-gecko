# Landmax Reader's own front-end parts (landmax-library: docs/site-apps-plan.md).

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

MOZ_SRC_FILES += [
    "LandmaxAppBar.sys.mjs",
    "LandmaxClean.sys.mjs",
    "LandmaxLayoutChild.sys.mjs",
    "LandmaxLayoutParent.sys.mjs",
    "LandmaxLoginsChild.sys.mjs",
    "LandmaxLoginsParent.sys.mjs",
    "LandmaxRecipes.sys.mjs",
]

JAR_MANIFESTS += ["jar.mn"]
